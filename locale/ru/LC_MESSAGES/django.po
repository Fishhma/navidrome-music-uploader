msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ru\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Music library"
msgstr "Музыкальная библиотека"

msgid "Language"
msgstr "Язык"

msgid "Administration"
msgstr "Администрирование"

msgid "Log out"
msgstr "Выйти"

msgid "Private uploads to your shared music library"
msgstr "Личная загрузка в вашу общую музыкальную библиотеку"

msgid "Sign in"
msgstr "Войти"

msgid "YOUR MUSIC LIBRARY"
msgstr "ВАША МУЗЫКАЛЬНАЯ БИБЛИОТЕКА"

msgid "Welcome back"
msgstr "С возвращением"

msgid "Sign in to upload music securely."
msgstr "Войдите, чтобы безопасно загрузить музыку."

msgid "Username"
msgstr "Имя пользователя"

msgid "Password"
msgstr "Пароль"

msgid "Used in the last 24 hours"
msgstr "Использовано за 24 часа"

msgid "No uploads yet"
msgstr "Загрузок пока нет"

msgid "Selected files and their processing status will appear here."
msgstr "Выбранные файлы появятся здесь со статусом обработки."

msgid "Upload music"
msgstr "Загрузить музыку"

msgid "SHARED LIBRARY"
msgstr "ОБЩАЯ БИБЛИОТЕКА"

msgid "Files will appear in the shared Navidrome library after indexing."
msgstr "Файлы появятся в общей библиотеке Navidrome после индексации."

msgid "Drop files here"
msgstr "Перетащите файлы сюда"

msgid "or click to choose files"
msgstr "или нажмите, чтобы выбрать файлы"

msgid "ZIP and RAR archives"
msgstr "архивы ZIP и RAR"

msgid "Archive password (if required)"
msgstr "Пароль архива (если требуется)"

#, python-format
msgid "Up to %(max_size)s per file · up to %(max_files)s files at a time"
msgstr "До %(max_size)s на файл · до %(max_files)s файлов за раз"

msgid "Upload files"
msgstr "Загрузить файлы"

msgid "Preparing…"
msgstr "Подготовка…"

msgid "PERSONAL ACTIVITY"
msgstr "ЛИЧНАЯ АКТИВНОСТЬ"

msgid "Recent uploads"
msgstr "Последние загрузки"

msgid "Only you can see this history"
msgstr "История видна только вам"

#, python-format
msgid "The %(type)s archive contains too many files."
msgstr "Архив %(type)s содержит слишком много файлов."

#, python-format
msgid "The %(type)s archive expands beyond the configured size limit."
msgstr "Архив %(type)s после распаковки превышает допустимый размер."

#, python-format
msgid "The %(type)s archive exceeds the configured compression ratio."
msgstr "Архив %(type)s превышает допустимую степень сжатия."

#, python-format
msgid "The %(type)s archive contains no supported audio files."
msgstr "В архиве %(type)s нет поддерживаемых аудиофайлов."

msgid "The ZIP archive is invalid."
msgstr "Архив ZIP повреждён или имеет неверный формат."

#, python-format
msgid "The %(type)s archive contains an unsafe path."
msgstr "Архив %(type)s содержит небезопасный путь."

msgid "AES-encrypted ZIP archives are not supported. Use RAR or an unencrypted ZIP."
msgstr "ZIP-архивы с AES-шифрованием не поддерживаются. Используйте RAR или ZIP без пароля."

msgid "This archive is password-protected. Enter the archive password."
msgstr "Архив защищён паролем. Введите пароль архива."

msgid "The archive password is incorrect."
msgstr "Неверный пароль архива."

msgid "The ZIP archive uses an unsupported compression method."
msgstr "ZIP-архив использует неподдерживаемый метод сжатия."

msgid "The archive password is incorrect or the archive is damaged."
msgstr "Неверный пароль архива или архив повреждён."

#, python-format
msgid "The ZIP archive is damaged (%(name)s)."
msgstr "ZIP-архив повреждён (%(name)s)."

msgid "The server cannot read this encrypted RAR archive."
msgstr "Сервер не может прочитать этот зашифрованный RAR-архив."

msgid "Multi-volume RAR archives are not supported. Upload a single-volume archive."
msgstr "Многотомные RAR-архивы не поддерживаются. Загрузите архив одним томом."

msgid "The RAR archive is invalid or the password is incorrect."
msgstr "RAR-архив повреждён или пароль неверный."

msgid "Extracting the RAR archive took too long."
msgstr "Распаковка RAR-архива заняла слишком много времени."

msgid "The RAR archive is damaged (checksum error)."
msgstr "RAR-архив повреждён (ошибка контрольной суммы)."

msgid "The server ran out of memory while extracting the archive."
msgstr "Серверу не хватило памяти для распаковки архива."

msgid "The RAR archive could not be extracted."
msgstr "Не удалось распаковать RAR-архив."

msgid "RAR extraction is unavailable on the server."
msgstr "Распаковка RAR недоступна на сервере."

#, python-format
msgid "The RAR archive could not extract %(name)s."
msgstr "Не удалось извлечь %(name)s из RAR-архива."

msgid "Done"
msgstr "Готово"

msgid "Duplicate"
msgstr "Повтор"

msgid "Failed"
msgstr "Ошибка"

msgid "Removed"
msgstr "Удалён"

msgid "The file is no longer in the library."
msgstr "Файла больше нет в библиотеке."

#, python-format
msgid "Same file as %(name)s in this upload."
msgstr "Тот же файл, что и %(name)s в этой загрузке."

#, python-format
msgid "Already uploaded on %(date)s by %(user)s as %(name)s."
msgstr "Уже загружен %(date)s пользователем %(user)s как %(name)s."

#, python-format
msgid "Same track as %(name)s in this upload."
msgstr "Тот же трек, что и %(name)s в этой загрузке."

#, python-format
msgid "This track (%(track)s) is already in the library: %(name)s."
msgstr "Этот трек (%(track)s) уже есть в библиотеке: %(name)s."

#, python-format
msgid "This track (%(track)s) is already in the Navidrome library: %(path)s."
msgstr "Этот трек (%(track)s) уже есть в библиотеке Navidrome: %(path)s."

msgid "The rolling 24-hour upload quota would be exceeded."
msgstr "Будет превышена квота загрузки за 24 часа."

msgid "This audio file has already been uploaded."
msgstr "Этот аудиофайл уже загружен."

msgid "The file exceeds the configured per-file size limit."
msgstr "Файл превышает установленный лимит размера."

msgid "Added to the shared music library."
msgstr "Добавлено в общую музыкальную библиотеку."

#, python-format
msgid "Added to the library as %(path)s."
msgstr "Добавлен в библиотеку: %(path)s."

#, python-format
msgid "%(count)d track from the archive is already in the library."
msgid_plural "All %(count)d tracks from the archive are already in the library."
msgstr[0] "%(count)d трек из архива уже есть в библиотеке."
msgstr[1] "Все %(count)d трека из архива уже есть в библиотеке."
msgstr[2] "Все %(count)d треков из архива уже есть в библиотеке."

#, python-format
msgid "Nothing was added: %(dup)d duplicate(s), %(bad)d invalid file(s)."
msgstr "Ничего не добавлено: повторов — %(dup)d, некорректных файлов — %(bad)d."

msgid "The archive contains no valid audio files."
msgstr "В архиве нет корректных аудиофайлов."

#, python-format
msgid "Extracted from %(type)s and added to the shared music library."
msgstr "Извлечён из %(type)s и добавлен в общую библиотеку."

#, python-format
msgid "Added %(count)d track to %(folder)s."
msgid_plural "Added %(count)d tracks to %(folder)s."
msgstr[0] "Добавлен %(count)d трек в %(folder)s."
msgstr[1] "Добавлено %(count)d трека в %(folder)s."
msgstr[2] "Добавлено %(count)d треков в %(folder)s."

#, python-format
msgid "Skipped %(count)d duplicate."
msgid_plural "Skipped %(count)d duplicates."
msgstr[0] "Пропущен %(count)d повтор."
msgstr[1] "Пропущено %(count)d повтора."
msgstr[2] "Пропущено %(count)d повторов."

#, python-format
msgid "Skipped %(count)d invalid file."
msgid_plural "Skipped %(count)d invalid files."
msgstr[0] "Пропущен %(count)d некорректный файл."
msgstr[1] "Пропущено %(count)d некорректных файла."
msgstr[2] "Пропущено %(count)d некорректных файлов."

msgid "Server storage is unavailable."
msgstr "Хранилище сервера недоступно."

msgid "The server could not process this file."
msgstr "Сервер не смог обработать этот файл."

msgid "Unsupported file type. Upload audio files or ZIP/RAR archives."
msgstr "Неподдерживаемый тип файла. Загрузите аудиофайлы или архивы ZIP/RAR."

msgid "The file contents do not match a supported audio format."
msgstr "Содержимое файла не соответствует поддерживаемому аудиоформату."

msgid "Uploading files…"
msgstr "Загрузка файлов…"

#, python-format
msgid "Transferring files: %(percent)s"
msgstr "Передача файлов: %(percent)s"

msgid "Processing on the server (extracting, checking for duplicates)…"
msgstr "Обработка на сервере (распаковка, проверка повторов)…"

msgid "Done."
msgstr "Готово."

msgid "Upload error."
msgstr "Ошибка загрузки."

msgid "Could not process the server response."
msgstr "Не удалось обработать ответ сервера."

#, python-format
msgid "Server error (HTTP %(status)s)."
msgstr "Ошибка сервера (HTTP %(status)s)."

msgid "The upload is too large for the server."
msgstr "Загрузка слишком велика для сервера."

msgid "Your session has expired. Refresh the page and sign in again."
msgstr "Сессия истекла. Обновите страницу и войдите снова."

msgid "Network error. Check your connection and refresh the page."
msgstr "Ошибка сети. Проверьте подключение и обновите страницу."

msgid "Upload cancelled."
msgstr "Загрузка отменена."

msgid "Details"
msgstr "Подробнее"

msgid "Navidrome library scan started."
msgstr "Запущено сканирование библиотеки Navidrome."

msgid "Partly added"
msgstr "Частично"

msgid "Select at least one file."
msgstr "Выберите хотя бы один файл."

#, python-format
msgid "At most %(max_files)s files can be uploaded in one request."
msgstr "За один раз можно загрузить не более %(max_files)s файлов."

msgid "The total upload request exceeds the server limit."
msgstr "Общий размер загрузки превышает серверный лимит."
