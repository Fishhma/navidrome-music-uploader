msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: cs\n"
"Plural-Forms: nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;\n"

msgid "Music library"
msgstr "Hudební knihovna"

msgid "Language"
msgstr "Jazyk"

msgid "Administration"
msgstr "Administrace"

msgid "Log out"
msgstr "Odhlásit se"

msgid "Private uploads to your shared music library"
msgstr "Soukromé nahrávání do vaší sdílené hudební knihovny"

msgid "Sign in"
msgstr "Přihlásit se"

msgid "YOUR MUSIC LIBRARY"
msgstr "VAŠE HUDEBNÍ KNIHOVNA"

msgid "Welcome back"
msgstr "Vítejte zpět"

msgid "Sign in to upload music securely."
msgstr "Přihlaste se a bezpečně nahrajte hudbu."

msgid "Username"
msgstr "Uživatelské jméno"

msgid "Password"
msgstr "Heslo"

msgid "Used in the last 24 hours"
msgstr "Využito za posledních 24 hodin"

msgid "No uploads yet"
msgstr "Zatím žádná nahrávání"

msgid "Selected files and their processing status will appear here."
msgstr "Vybrané soubory a stav jejich zpracování se zobrazí zde."

msgid "Upload music"
msgstr "Nahrát hudbu"

msgid "SHARED LIBRARY"
msgstr "SDÍLENÁ KNIHOVNA"

msgid "Files will appear in the shared Navidrome library after indexing."
msgstr "Soubory se po zaindexování objeví ve sdílené knihovně Navidrome."

msgid "Drop files here"
msgstr "Přetáhněte soubory sem"

msgid "or click to choose files"
msgstr "nebo kliknutím vyberte soubory"

msgid "ZIP and RAR archives"
msgstr "archivy ZIP a RAR"

msgid "Archive password (if required)"
msgstr "Heslo archivu (je-li vyžadováno)"

#, python-format
msgid "Up to %(max_size)s per file · up to %(max_files)s files at a time"
msgstr "Max. %(max_size)s na soubor · max. %(max_files)s souborů najednou"

msgid "Upload files"
msgstr "Nahrát soubory"

msgid "Preparing…"
msgstr "Příprava…"

msgid "PERSONAL ACTIVITY"
msgstr "OSOBNÍ AKTIVITA"

msgid "Recent uploads"
msgstr "Poslední nahrané soubory"

msgid "Only you can see this history"
msgstr "Tuto historii vidíte pouze vy"

#, python-format
msgid "The %(type)s archive contains too many files."
msgstr "Archiv %(type)s obsahuje příliš mnoho souborů."

#, python-format
msgid "The %(type)s archive expands beyond the configured size limit."
msgstr "Archiv %(type)s po rozbalení překračuje povolenou velikost."

#, python-format
msgid "The %(type)s archive exceeds the configured compression ratio."
msgstr "Archiv %(type)s překračuje povolený kompresní poměr."

#, python-format
msgid "The %(type)s archive contains no supported audio files."
msgstr "Archiv %(type)s neobsahuje žádné podporované zvukové soubory."

msgid "The ZIP archive is invalid."
msgstr "Archiv ZIP je neplatný."

#, python-format
msgid "The %(type)s archive contains an unsafe path."
msgstr "Archiv %(type)s obsahuje nebezpečnou cestu."

msgid "AES-encrypted ZIP archives are not supported. Use RAR or an unencrypted ZIP."
msgstr "Archivy ZIP šifrované AES nejsou podporovány. Použijte RAR nebo nešifrovaný ZIP."

msgid "This archive is password-protected. Enter the archive password."
msgstr "Archiv je chráněn heslem. Zadejte heslo archivu."

msgid "The archive password is incorrect."
msgstr "Heslo archivu je nesprávné."

msgid "The ZIP archive uses an unsupported compression method."
msgstr "Archiv ZIP používá nepodporovanou metodu komprese."

msgid "The archive password is incorrect or the archive is damaged."
msgstr "Heslo archivu je nesprávné nebo je archiv poškozený."

#, python-format
msgid "The ZIP archive is damaged (%(name)s)."
msgstr "Archiv ZIP je poškozený (%(name)s)."

msgid "The server cannot read this encrypted RAR archive."
msgstr "Server nedokáže přečíst tento šifrovaný archiv RAR."

msgid "Multi-volume RAR archives are not supported. Upload a single-volume archive."
msgstr "Vícesvazkové archivy RAR nejsou podporovány. Nahrajte archiv v jednom svazku."

msgid "The RAR archive is invalid or the password is incorrect."
msgstr "Archiv RAR je neplatný nebo je heslo nesprávné."

msgid "Extracting the RAR archive took too long."
msgstr "Rozbalování archivu RAR trvalo příliš dlouho."

msgid "The RAR archive is damaged (checksum error)."
msgstr "Archiv RAR je poškozený (chyba kontrolního součtu)."

msgid "The server ran out of memory while extracting the archive."
msgstr "Serveru došla paměť při rozbalování archivu."

msgid "The RAR archive could not be extracted."
msgstr "Archiv RAR se nepodařilo rozbalit."

msgid "RAR extraction is unavailable on the server."
msgstr "Rozbalování RAR není na serveru dostupné."

#, python-format
msgid "The RAR archive could not extract %(name)s."
msgstr "Z archivu RAR se nepodařilo rozbalit %(name)s."

msgid "Done"
msgstr "Hotovo"

msgid "Duplicate"
msgstr "Duplikát"

msgid "Failed"
msgstr "Chyba"

msgid "Removed"
msgstr "Odstraněno"

msgid "The file is no longer in the library."
msgstr "Soubor už v knihovně není."

#, python-format
msgid "Same file as %(name)s in this upload."
msgstr "Stejný soubor jako %(name)s v tomto nahrávání."

#, python-format
msgid "Already uploaded on %(date)s by %(user)s as %(name)s."
msgstr "Již nahráno %(date)s uživatelem %(user)s jako %(name)s."

#, python-format
msgid "Same track as %(name)s in this upload."
msgstr "Stejná skladba jako %(name)s v tomto nahrávání."

#, python-format
msgid "This track (%(track)s) is already in the library: %(name)s."
msgstr "Tato skladba (%(track)s) už v knihovně je: %(name)s."

#, python-format
msgid "This track (%(track)s) is already in the Navidrome library: %(path)s."
msgstr "Tato skladba (%(track)s) už je v knihovně Navidrome: %(path)s."

msgid "The rolling 24-hour upload quota would be exceeded."
msgstr "Byla by překročena kvóta nahrávání za posledních 24 hodin."

msgid "This audio file has already been uploaded."
msgstr "Tento zvukový soubor už byl nahrán."

msgid "The file exceeds the configured per-file size limit."
msgstr "Soubor překračuje nastavený limit velikosti."

msgid "Added to the shared music library."
msgstr "Přidáno do sdílené hudební knihovny."

#, python-format
msgid "Added to the library as %(path)s."
msgstr "Přidáno do knihovny jako %(path)s."

#, python-format
msgid "%(count)d track from the archive is already in the library."
msgid_plural "All %(count)d tracks from the archive are already in the library."
msgstr[0] "%(count)d skladba z archivu už v knihovně je."
msgstr[1] "Všechny %(count)d skladby z archivu už v knihovně jsou."
msgstr[2] "Všech %(count)d skladeb z archivu už v knihovně je."

#, python-format
msgid "Nothing was added: %(dup)d duplicate(s), %(bad)d invalid file(s)."
msgstr "Nic nebylo přidáno: duplikáty %(dup)d, neplatné soubory %(bad)d."

msgid "The archive contains no valid audio files."
msgstr "Archiv neobsahuje žádné platné zvukové soubory."

#, python-format
msgid "Extracted from %(type)s and added to the shared music library."
msgstr "Rozbaleno z %(type)s a přidáno do sdílené hudební knihovny."

#, python-format
msgid "Added %(count)d track to %(folder)s."
msgid_plural "Added %(count)d tracks to %(folder)s."
msgstr[0] "Přidána %(count)d skladba do %(folder)s."
msgstr[1] "Přidány %(count)d skladby do %(folder)s."
msgstr[2] "Přidáno %(count)d skladeb do %(folder)s."

#, python-format
msgid "Skipped %(count)d duplicate."
msgid_plural "Skipped %(count)d duplicates."
msgstr[0] "Přeskočen %(count)d duplikát."
msgstr[1] "Přeskočeny %(count)d duplikáty."
msgstr[2] "Přeskočeno %(count)d duplikátů."

#, python-format
msgid "Skipped %(count)d invalid file."
msgid_plural "Skipped %(count)d invalid files."
msgstr[0] "Přeskočen %(count)d neplatný soubor."
msgstr[1] "Přeskočeny %(count)d neplatné soubory."
msgstr[2] "Přeskočeno %(count)d neplatných souborů."

msgid "Server storage is unavailable."
msgstr "Úložiště serveru není dostupné."

msgid "The server could not process this file."
msgstr "Server tento soubor nedokázal zpracovat."

msgid "Unsupported file type. Upload audio files or ZIP/RAR archives."
msgstr "Nepodporovaný typ souboru. Nahrajte zvukové soubory nebo archivy ZIP/RAR."

msgid "The file contents do not match a supported audio format."
msgstr "Obsah souboru neodpovídá podporovanému zvukovému formátu."

msgid "Uploading files…"
msgstr "Nahrávání souborů…"

#, python-format
msgid "Transferring files: %(percent)s"
msgstr "Přenos souborů: %(percent)s"

msgid "Processing on the server (extracting, checking for duplicates)…"
msgstr "Zpracování na serveru (rozbalování, kontrola duplikátů)…"

msgid "Done."
msgstr "Hotovo."

msgid "Upload error."
msgstr "Chyba nahrávání."

msgid "Could not process the server response."
msgstr "Odpověď serveru se nepodařilo zpracovat."

#, python-format
msgid "Server error (HTTP %(status)s)."
msgstr "Chyba serveru (HTTP %(status)s)."

msgid "The upload is too large for the server."
msgstr "Nahrávaný obsah je pro server příliš velký."

msgid "Your session has expired. Refresh the page and sign in again."
msgstr "Relace vypršela. Obnovte stránku a přihlaste se znovu."

msgid "Network error. Check your connection and refresh the page."
msgstr "Chyba sítě. Zkontrolujte připojení a obnovte stránku."

msgid "Upload cancelled."
msgstr "Nahrávání zrušeno."

msgid "Details"
msgstr "Podrobnosti"

msgid "Navidrome library scan started."
msgstr "Spuštěno prohledání knihovny Navidrome."

msgid "Partly added"
msgstr "Částečně"

msgid "Select at least one file."
msgstr "Vyberte alespoň jeden soubor."

#, python-format
msgid "At most %(max_files)s files can be uploaded in one request."
msgstr "V jednom požadavku lze nahrát nejvýše %(max_files)s souborů."

msgid "The total upload request exceeds the server limit."
msgstr "Celková velikost nahrávání překračuje limit serveru."
